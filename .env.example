SECRET_KEY=your-secret-key-here
DEBUG=True
SITE_NAME=GarageManager

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

