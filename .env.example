CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# SIMPLE_JWT
ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=1
